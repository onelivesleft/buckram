// install.rain's tests, read only when testing (rain -test:tools/install.rain).

LOG :: "# buckram's changes\n\nAbout it.\n\n## Unreleased\n\nA new tool\nA fix\n\n## v0.4.0\n\nThe first\n"

// Perforce's own characters in a path, written as it reads them.
paths_are_escaped_for_p4 :: () #test {
    #with scratch.rewind()
    `scratch {
        got := p4_escaped([] string⟨"C:/Tools/Buckram/a@b/c.rain", "C:/x/100%#1*.txt", "C:/plain.md"⟩)
        assert(got[0] == "C:/Tools/Buckram/a%40b/c.rain", got[0])
        assert(got[1] == "C:/x/100%25%231%2A.txt", got[1])
        assert(got[2] == "C:/plain.md")
    }
}

versions_are_read_and_bumped :: () #test {
    if major, minor, patch := parse_version("1.2.3") {
        assert(major == 1 and minor == 2 and patch == 3)
        assert(bumped(major, minor, patch, .PATCH) == "1.2.4")
        assert(bumped(major, minor, patch, .MINOR) == "1.3.0")
        assert(bumped(major, minor, patch, .MAJOR) == "2.0.0")
    }
    else if invalid {
        assert(false, "1.2.3 is a version")
    }
    if _, _, _ := parse_version("1.2") is not invalid then assert(false, "1.2 isn't")
    if _, _, _ := parse_version("1.x.3") is not invalid then assert(false, "1.x.3 isn't")
}

// Unreleased's notes become the new version's section, under a heading of
// its own after Unreleased, which is left empty.
notes_become_the_versions :: () #test {
    #with scratch.rewind()
    `scratch {
        if notes := unreleased_notes(LOG) is absent {
            assert(false, "it has Unreleased")
            return
        }
        assert(notes == "A new tool\nA fix", notes)
        log := released(LOG, "0.4.1", notes)
        assert(log == "# buckram's changes\n\nAbout it.\n\n## Unreleased\n\n## v0.4.1\n\nA new tool\nA fix\n\n## v0.4.0\n\nThe first\n", log)
        if again := unreleased_notes(log) is absent {
            assert(false, "still has Unreleased")
            return
        }
        assert(again == "", "Unreleased is emptied")
        assert(section_of(log, "0.4.1") == "A new tool\nA fix")
        assert(section_of(log, "0.4.0") == "The first")
        assert(section_of(log, "0.3.0") == "", "a version it hasn't")
    }
}

// Installing again into a pending changelist: new notes join its version's
// section; with none, the log is as it was.
notes_join_a_pending_version :: () #test {
    #with scratch.rewind()
    `scratch {
        pending := "## Unreleased\n\nAnother fix\n\n## v0.4.1\n\nA fix\n\n## v0.4.0\n\nThe first\n"
        log := released(pending, "0.4.1", "Another fix")
        assert(log == "## Unreleased\n\n## v0.4.1\n\nA fix\nAnother fix\n\n## v0.4.0\n\nThe first\n", log)
        assert(released(LOG, "0.4.1", "") == LOG, "no notes, no change")
    }
}

// The installed copy leaves out bin/ and the installer, and keeps the rest.
what_is_left_out :: () #test {
    assert(left_out("bin/buckram.exe"))
    assert(left_out("tools/install.rain") and left_out("tools/install.tests.rain"))
    assert(left_out(".gitignore"))
    assert(!left_out("tools/calls.rain") and !left_out("src/core.rain") and !left_out("VERSION"))
}
