# bin/'s exes are committed, so buckram runs without building it. Not
# committed: build.exe (built from build.rain), the exes build.exe moved
# aside while they ran, and scratch.
/*.exe
bin/old_exes/
*.obj
*.pdb
*.ll
# what the Linux build leaves beside its programs (LLVM's object and IR)
*.o
*.llvm.txt
build/
