// Builds buckram: bin/buckram.exe (the stub, from src/stub.rain) and
// bin/buckram_core.exe (from src/core.rain) for Windows, and bin/buckram and
// bin/buckram_core for Linux (built here, with -os:linux, through LLVM),
// with the 'rain compiler (rain on the PATH, or the one given):
//
//     rain build.rain
//     build.exe [path to rain.exe]
//
// The programs in bin/ are committed, so buckram can be used without
// building it; build them again after changing src/.
//
// Each is built under a new name first (bin/old_exes/new_buckram.exe), and
// takes the old one's place only once it has built: so a build that fails
// leaves bin/ as it was, and buckram still has its core. Windows won't
// overwrite a running exe, but will rename one, and the stub runs as long
// as its agent's session: so one in use is moved into bin/old_exes, and runs
// on from there. Those no longer running are cleared out each time. (The
// core runs only while it answers a message, so it's rarely in use; it's
// treated the same way.)

#import Console
#import String
#import File
#import System

main :: (args: [] string) [failed: string] {
    *compiler := "rain"
    if args.count > 1 then compiler = args[1]
    *here := System.current_folder()
    if whole := File.full_path(args[0]) is not os_error { here = File.folder_of(whole) }
    bin := File.join_path(here, "bin")
    old := File.join_path(bin, "old_exes")
    if File.create_folder(old) is os_error { fail: failed = "bin/old_exes can't be made («os_error»)" }
    // The ones no longer running go (one still running can't be deleted).
    if entries := File.files_in(old) is not absent or os_error {
        for entry: entries {
            if entry.is_folder then continue
            if File.delete_file(entry.path) is absent or os_error { }
        }
    }
    if build_one(compiler, here, old, "src/stub.rain", "buckram.exe", "windows") is failed { fail: failed = failed }
    if build_one(compiler, here, old, "src/core.rain", "buckram_core.exe", "windows") is failed { fail: failed = failed }
    if build_one(compiler, here, old, "src/stub.rain", "buckram", "linux") is failed { fail: failed = failed }
    if build_one(compiler, here, old, "src/core.rain", "buckram_core", "linux") is failed { fail: failed = failed }
}

build_one :: (compiler: string, here: string, old: string, source: string, exe: string, os: string) [failed: string] {
    `scratch {
        target := File.join_path(here, "bin", exe)
        // Built beside the old ones first.
        built := File.join_path(old, "new_«exe»")
        if File.delete_file(built) is absent or os_error { }
        if code, output, errors := System.run(compiler, File.join_path(here, source), "-os:«os»", "-out:«built»") {
            // What a build through LLVM leaves beside it (its IR, object, and
            // clang's messages): not buckram's.
            for leftover: [] string⟨".ll", ".o", ".llvm.txt"⟩ {
                if File.delete_file("«built»«leftover»") is absent or os_error { }
            }
            if code != 0 or !File.file_exists(built) {
                if File.delete_file(built) is absent or os_error { }
                fail: failed = "«source» didn't build, so bin/«exe» is as it was:\n«output»«errors»"
            }
        }
        else if absent {
            fail: failed = "there's no compiler '«compiler»': give its path, build.exe C:/rain/build/rain.exe"
        }
        else if os_error {
            fail: failed = "the compiler couldn't be run («os_error»)"
        }
        // Then the old one goes, and the new one takes its place.
        if File.file_exists(target) {
            if File.delete_file(target) is {
                case absent: _
                case os_error:
                    // In use: moved aside, to run on from there.
                    *n := 1
                    while File.file_exists(File.join_path(old, aside_name(exe, n))) { n += 1 }
                    aside := File.join_path(old, aside_name(exe, n))
                    if File.rename_file(target, aside) {
                        echo("«exe» is in use: moved to bin/old_exes/«File.file_name(aside)», where it runs on")
                    }
                    else if absent or os_error {
                        fail: failed = "«exe» is in use, and can't be moved aside either: the new one is bin/old_exes/new_«exe»"
                    }
            }
        }
        if File.rename_file(built, target) is absent or os_error {
            fail: failed = "bin/old_exes/new_«exe» can't be moved to bin/«exe»: move it by hand"
        }
        echo("built bin/«exe»")
    }
}

// The name one moved aside gets: buckram_core_2.exe, or buckram_2.
aside_name :: (exe: string, n: i64 -> string) {
    return if File.extension(exe) == "" then "«exe»_«n»" else "«File.without_extension(exe)»_«n».«File.extension(exe)»"
}
