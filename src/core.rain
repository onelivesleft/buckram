// buckram's core: what each of buckram's tools does. bin/buckram.exe (the
// stub, which the agent's harness keeps running) starts it afresh for each
// message, in the project's folder, gives it the message as its standard
// input, and passes on what it writes: one JSON-RPC response, on one line.
// So a rebuilt core is in use from the next message on, and a changed
// buckram.json too, with nothing to restart. Nothing reaches it on a
// command line: the message is its input, and the folder is where it
// starts.
//
// Each tool takes its arguments as JSON and runs a program with them as a
// list, so nothing is quoted, escaped or expanded on the way: a backslash,
// a $ or a quote arrives as it is.
//
// Its tools:
//   run          a program, with its arguments, folder, input and timeout
//                (but git, which goes through git)
//   git          any of git's commands, in the project or a folder (a
//                commit's message is given as text, never on a command line);
//                before one that can lose uncommitted work, the working tree
//                is saved as a commit, and one that makes a loss permanent
//                takes "permanent": true
//   edit         exact replacements in files, all or none
//   files        list, copy, move and delete files and folders (files.rain)
//   processes    list running processes, or end them (files.rain)
//   task         a task of buckram.json's by name (one added since the
//                client last listed the tools included)
//   add_task     adds (or replaces) a task in buckram.json
//   remove_task  takes one out
//   and each task the project's buckram.json declares (build, test, ...)
//
// What a program writes comes back as its exit code, then its output and
// errors, cut in the middle past output_limit bytes (the whole of it is
// kept in output_folder, under the tool's name).
//
// Each call is logged, a JSON object a line, in output_folder/calls.jsonl:
// when, the tool, its arguments, how long it took, whether it was an
// error, and how big its result was. Read, it shows which jobs come up
// often enough to be a task, or a tool of buckram's own.
//
// The project's buckram.json:
//
//     {
//       "output_limit": 8192,
//       "output_folder": "build/buckram",
//       "tasks": {
//         "build": { "description": "Builds the compiler.", "run": ["cmd", "/c", ".\\build.bat"] },
//         "test":  { "description": "Runs the tests.", "run": ["build/rain.exe", "-test:tests"],
//                    "arguments": "list", "timeout": 900 }
//       }
//     }
//
// A task's "arguments" is "none" (the default) or "list": then the tool
// takes a list of strings, added after its run. Its timeout is in seconds
// (600 by default), and a call can give its own. A timeout ends what the
// program started too.
//
// Every tool refuses a parameter it hasn't (naming those it has), rather
// than dropping it without a word.

#import "Console"
#import "String"
#import "File"
#import "System"
#import "Json"
#import "Time"

#load "files.rain"

VERSION :: "0.2.0"
PROTOCOL :: "2025-06-18"             // the MCP version given when the client asks for none
DEFAULT_TIMEOUT : f64 : 600
// git's commands that only look, or only add to what's kept (add, commit,
// fetch, tag, branch, ...): nothing they do can lose work, so nothing is
// saved before them.
LOOKING :: "status diff log show add commit grep ls-files ls-tree cat-file rev-parse rev-list merge-base for-each-ref blame describe shortlog fetch remote tag branch notes config help version check-ignore count-objects fsck name-rev show-ref symbolic-ref var whatchanged range-diff format-patch archive bundle verify-commit verify-tag"
OWN_TOOLS :: [] string ⟨"run", "git", "edit", "files", "processes", "task", "add_task", "remove_task"⟩
CONFIG_FILE :: "buckram.json"

Takes :: enum { NONE; LIST }

Task :: struct {
    name: string
    description: string
    command: [] string           // the program, then its arguments
    takes: Takes
    timeout: f64
}

Config :: struct {
    folder: string               // the project's (the one buckram was started in)
    output_limit: i64
    output_folder: string        // relative to folder
    tasks: [] Task
}

config: Config

// One message, from its input; the answer (if it needs one) to its output.
main :: () {
    config = load_config()
    if line := read_line() is not end_of_input then handle(line)
}

is_own_tool :: (name: string -> bool) {
    for own: OWN_TOOLS { if own == name then return true }
    return false
}

log :: (text: string) {
    echo(.ERROR, "buckram: «text»")
}

//- buckram.json

load_config :: (-> loaded: Config) {
    loaded = ⟨⟩
    loaded.folder = current_folder()
    loaded.output_limit = 8192
    loaded.output_folder = "build/buckram"
    *tasks: [..] Task
    if contents := read_file(join_path(loaded.folder, CONFIG_FILE)) is {
        case absent:
        case os_error:
            log("buckram.json can't be read («os_error»)")
    } else {
        if value := parse_json(contents) {
            if limit := member(value, "output_limit") is not absent {
                if limit is number {
                    if n := to_i64(number) { if n > 64 then loaded.output_limit = n } else if invalid or too_big { log("output_limit isn't a whole number") }
                }
            }
            if folder := member(value, "output_folder") is not absent {
                if folder is text { loaded.output_folder = text }
            }
            if declared := member(value, "tasks") is not absent {
                if declared is object {
                    for name, i: object.names {
                        if is_own_tool(name) {
                            log("the task '«name»' has the name of one of buckram's own tools, so it's left out")
                            continue
                        }
                        if task := read_task(name, object.values[i]) { tasks.add(task) } else if bad_task { log("the task '«name»': «bad_task»") }
                    }
                }
            }
        } else if bad_json {
            log("buckram.json isn't JSON (at byte «bad_json.at»: «bad_json.why»), so it has no tasks")
        }
    }
    loaded.tasks = tasks
}

read_task :: (name: string, value: Json -> task: Task) [bad_task: string] {
    task = ⟨⟩
    task.name = name
    task.timeout = DEFAULT_TIMEOUT
    task.description = text_member(value, "description")
    *command: [..] string
    if run := member(value, "run") is not absent {
        if run is list {
            for piece: list {
                if piece is text { command.add(text) } else { fail: bad_task = "its run is a list of strings, the program first" }
            }
        }
    }
    if command.count == 0 then fail: bad_task = "it needs a run: the program and its arguments, as a list of strings"
    task.command = command
    takes := text_member(value, "arguments")
    if takes == "list" { task.takes = .LIST }
    else if takes != "" and takes != "none" { fail: bad_task = #"its arguments is "none" or "list""# }
    if timeout := member(value, "timeout") is not absent {
        if timeout is number {
            if t := to_f64(number) is not invalid { task.timeout = t }
        }
    }
}

// A member that's a string, or "".
text_member :: (value: Json, name: string -> string) {
    if found := member(value, name) {
        if found is text then return text
        return ""
    } else if absent {
        return ""
    }
}

// A member that's a list of strings (others left out), or none.
texts_member :: (value: Json, name: string -> [] string) {
    *texts: [..] string
    if found := member(value, name) {
        if found is list {
            for item: list { if item is text { texts.add(text) } }
        }
        return texts
    } else if absent {
        return texts
    }
}

//- the protocol: JSON-RPC 2.0, a message a line

handle :: (line: string) {
    if trim(line).count == 0 then return
    if request := parse_json(line) {
        method := text_member(request, "method")
        *id: Json
        *has_id := false
        if given := member(request, "id") is not absent {
            id = given
            has_id = true
        }
        if !has_id then return        // a notification (notifications/initialized, ...): nothing to answer
        *params: Json
        if p := member(request, "params") is not absent { params = p }
        *result: [..] u8
        if method == "tools/list" {
            list_tools(result)
        } else if method == "tools/call" {
            call_tool(result, params)
        } else if method == "ping" {
            append(result, "{}")
        } else {
            respond_error(id, -32601, "there's no method '«method»'")
            return
        }
        respond(id, string'result)
    } else if bad_json {
        respond_error(Json.none, -32700, "this isn't JSON: «bad_json.why» (at byte «bad_json.at»)")
    }
}

respond :: (id: Json, result: string) {
    *out: [..] u8
    append(out, #"{"jsonrpc":"2.0","id":"#)
    write_json(out, id)
    append(out, #","result":"#, result, "}")
    echo(string'out)
}

respond_error :: (id: Json, code: i64, message: string) {
    *out: [..] u8
    append(out, #"{"jsonrpc":"2.0","id":"#)
    write_json(out, id)
    append(out, #","error":{"code":«code»,"message":"#)
    write_json_text(out, message)
    append(out, "}}")
    echo(string'out)
}


//- the tools

ARGUMENTS_SCHEMA :: #"{"type":"array","items":{"type":"string"}}"#

list_tools :: (out: *[..] u8) {
    append(out, #"{"tools":["#)
    tool(out, "run", "Runs a program and waits for it: the program (a path, or a name on the PATH), its arguments as a list (each arrives exactly as given), and if wanted the folder it starts in (the project's by default), its standard input, and a timeout in seconds (600 by default; it ends what the program started too). Gives its exit code, output and errors. Not git: that's the git tool's.",
         #"{"type":"object","properties":{"program":{"type":"string"},"arguments":«ARGUMENTS_SCHEMA»,"folder":{"type":"string"},"input":{"type":"string"},"timeout":{"type":"number"}},"required":["program"]}"#)
    append(out, ",")
    tool(out, "git", #"Runs any of git's commands (operation: status, diff, log, add, commit, checkout, reset, rebase, stash...) with more arguments as a list, in the project or in folder. A commit takes its message as message (given to git as its input, never on a command line). Before a command that can lose uncommitted work (checkout, reset, restore, stash, clean, rebase...), the working tree is saved as a commit, untracked files too (but not ignored ones), without touching it or the index, and the result begins with the commit, from which `git restore --source=<commit> -- <path>` brings a file back (they're kept as refs/buckram/saved/*). One that makes a loss permanent (reflog expire or delete, gc --prune, prune, a forced push or a deleted remote branch) runs only with "permanent": true: ask the user first."#,
         #"{"type":"object","properties":{"operation":{"type":"string"},"arguments":«ARGUMENTS_SCHEMA»,"message":{"type":"string"},"folder":{"type":"string"},"permanent":{"type":"boolean"}},"required":["operation"]}"#)
    append(out, ",")
    tool(out, "edit", #"Makes exact replacements in files, all or none: each edit's old text must be in its file exactly count times (1 by default), and every one is replaced with new. If any edit's old text isn't found as often, nothing is written. A file with no old text ("") that doesn't exist is made with new as its contents. Paths are the project's."#,
         #"{"type":"object","properties":{"edits":{"type":"array","items":{"type":"object","properties":{"file":{"type":"string"},"old":{"type":"string"},"new":{"type":"string"},"count":{"type":"integer"}},"required":["file","old","new"]}}},"required":["edits"]}"#)
    append(out, ",")
    tool(out, "files", #"Files and folders, with no program to write: list (path, the project's folder by default: each entry's size, when it was last written, and its name; all: true for everything beneath it too), copy or move (from, to: a file, or a folder and all in it; files there are replaced, and the folders on the way made), and delete (paths: files, or folders with everything in them; read-only files are made writable first). Paths are the project's unless whole."#,
         #"{"type":"object","properties":{"operation":{"type":"string","enum":["list","copy","move","delete"]},"path":{"type":"string"},"all":{"type":"boolean"},"from":{"type":"string"},"to":{"type":"string"},"paths":«ARGUMENTS_SCHEMA»},"required":["operation"]}"#)
    append(out, ",")
    tool(out, "processes", #"The running processes: list (each one's id, its parent's, and its program; name to show only those whose program's name contains it), or end (name: every process of that program, such as rain.exe; or ids). buckram, and what started it (the agent's own client), are never ended."#,
         #"{"type":"object","properties":{"operation":{"type":"string","enum":["list","end"]},"name":{"type":"string"},"ids":{"type":"array","items":{"type":"integer"}}},"required":["operation"]}"#)
    append(out, ",")
    *names: [..] u8
    for task, i: config.tasks {
        if i > 0 then append(names, ", ")
        append(names, task.name)
    }
    if names.count == 0 then append(names, "none yet")
    tool(out, "task", "Runs one of the project's tasks (from buckram.json) by name, with arguments as a list for one that takes them, and a timeout in seconds if not its own: the way to run a task added since the tools were last listed. Its tasks now: «string'names».",
         #"{"type":"object","properties":{"name":{"type":"string"},"arguments":«ARGUMENTS_SCHEMA»,"timeout":{"type":"number"}},"required":["name"]}"#)
    append(out, ",")
    tool(out, "add_task", #"Adds a task to the project's buckram.json, or replaces one of the name: a program and its arguments (run, the program first; one given as a path is the project's), a description, whether it takes more arguments as a list (arguments: "none" or "list"), and a timeout in seconds. It becomes a tool of its own once the client lists the tools again (buckram tells it to); task runs it meanwhile."#,
         #"{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"},"run":«ARGUMENTS_SCHEMA»,"arguments":{"type":"string","enum":["none","list"]},"timeout":{"type":"number"}},"required":["name","run"]}"#)
    append(out, ",")
    tool(out, "remove_task", "Takes a task out of the project's buckram.json.",
         #"{"type":"object","properties":{"name":{"type":"string"}},"required":["name"]}"#)
    for task: config.tasks {
        append(out, ",")
        *description := task.description
        if description == "" then description = "Runs the project's task '«task.name»'."
        if task.takes == .LIST {
            tool(out, task.name, "«description» Arguments given as a list are added after its own. It's ended after «seconds_text(task.timeout)» seconds, unless given a timeout.",
                 #"{"type":"object","properties":{"arguments":«ARGUMENTS_SCHEMA»,"timeout":{"type":"number"}}}"#)
        } else {
            tool(out, task.name, "«description» It's ended after «seconds_text(task.timeout)» seconds, unless given a timeout.", #"{"type":"object","properties":{"timeout":{"type":"number"}}}"#)
        }
    }
    append(out, "]}")
}

tool :: (out: *[..] u8, name: string, description: string, schema: string) {
    append(out, #"{"name":"#)
    write_json_text(out, name)
    append(out, #","description":"#)
    write_json_text(out, description)
    append(out, #","inputSchema":"#, schema, "}")
}

call_tool :: (out: *[..] u8, params: Json) {
    start := current_time_monotonic()
    name := text_member(params, "name")
    *arguments: Json
    if given := member(params, "arguments") is not absent { arguments = given }
    call_named_tool(out, name, arguments)
    record_call(name, arguments, current_time_monotonic() - start, string'out)
}

ERROR_RESULT_END :: #""isError":true}"#

// The call's line in output_folder/calls.jsonl.
record_call :: (name: string, arguments: Json, took: Apollo_Time, result: string) {
    folder := join_path(config.folder, config.output_folder)
    if !folder_exists(folder) { if create_folder(folder) is os_error { } }
    *ms: i64 = 0
    if m := to_milliseconds(took, true) { ms = m } else if too_big { }
    *line: [..] u8
    append(line, #"{"time":"#)
    write_json_text(line, "«current_time_consensus()»")
    append(line, #","tool":"#)
    write_json_text(line, name)
    append(line, #","arguments":"#)
    write_json(line, arguments)
    append(line, #","ms":«ms»,"error":«ends_with(result, ERROR_RESULT_END)»,"bytes":«result.count»}"#, "\n")
    if append_file(join_path(folder, "calls.jsonl"), string'line) is absent or os_error { }
}

call_named_tool :: (out: *[..] u8, name: string, arguments: Json) {
    // Each tool's parameters: one it hasn't is refused, rather than
    // dropped without a word.
    if name == "run" { if takes_only(out, name, arguments, "program arguments folder input timeout") then run_tool(out, arguments); return }
    if name == "git" { if takes_only(out, name, arguments, "operation command arguments message folder permanent") then git_tool(out, arguments); return }
    if name == "edit" { if takes_only(out, name, arguments, "edits") then edit_tool(out, arguments); return }
    if name == "files" { if takes_only(out, name, arguments, "operation path all from to paths") then files_tool(out, arguments); return }
    if name == "processes" { if takes_only(out, name, arguments, "operation name ids") then processes_tool(out, arguments); return }
    if name == "add_task" { if takes_only(out, name, arguments, "name description run arguments timeout") then add_task_tool(out, arguments); return }
    if name == "remove_task" { if takes_only(out, name, arguments, "name") then remove_task_tool(out, arguments); return }
    if name == "task" {
        if !takes_only(out, name, arguments, "name arguments timeout") then return
        wanted := text_member(arguments, "name")
        for task: config.tasks {
            if task.name == wanted {
                run_task(out, task, arguments)
                return
            }
        }
        tool_result(out, "there's no task '«wanted»' in «CONFIG_FILE» (its tasks: «task_names()»)", true)
        return
    }
    for task: config.tasks {
        if task.name == name {
            *parameters := "timeout"
            if task.takes == .LIST then parameters = "arguments timeout"
            if takes_only(out, name, arguments, parameters) then run_task(out, task, arguments)
            return
        }
    }
    tool_result(out, "there's no tool '«name»'", true)
}

// Does the call give only parameters the tool has (names, separated by
// spaces)? If not, its error is the result.
takes_only :: (out: *[..] u8, tool_name: string, arguments: Json, names: string -> bool) {
    if arguments is object {
        for given: object.names {
            *known := false
            for name: split(names, " ") { if name == given then known = true }
            if !known {
                tool_result(out, "«tool_name» has no parameter '«given»' (its parameters: «replace(names, " ", ", ")»)", true)
                return false
            }
        }
    }
    return true
}

// Seconds as text: 600, or 0.5.
seconds_text :: (seconds: f64 -> string) {
    whole := i64'seconds
    if f64'whole == seconds then return "«whole»"
    return "«seconds»"
}

// A number of seconds: given as a number, or a string of one (as agents
// often give it); the fallback when it isn't given.
seconds_member :: (value: Json, name: string, fallback: f64 -> seconds: f64) [bad_seconds: string] {
    seconds = fallback
    if found := member(value, name) is not absent {
        if found is number {
            if s := to_f64(number) { seconds = s } else if invalid { fail: bad_seconds = "«name» is a number of seconds, not «number»" }
        } else if found is text {
            if s := to_f64(trim(text)) { seconds = s } else if invalid { fail: bad_seconds = "«name» is a number of seconds, not '«text»'" }
        } else {
            fail: bad_seconds = "«name» is a number of seconds"
        }
    }
}

task_names :: (-> string) {
    *names: [..] u8
    for task, i: config.tasks {
        if i > 0 then append(names, ", ")
        append(names, task.name)
    }
    if names.count == 0 then append(names, "none")
    return string'names
}

run_task :: (out: *[..] u8, task: Task, arguments: Json) {
    *command: [..] string
    for piece: task.command[1:] { command.add(piece) }
    if task.takes == .LIST {
        for extra: texts_member(arguments, "arguments") { command.add(extra) }
    }
    // A program given as a path (build/rain.exe) is the project's.
    *program := task.command[0]
    if contains_any(program, "/\\") then program = in_project(program)
    // Its timeout, or the call's.
    *timeout := task.timeout
    if seconds := seconds_member(arguments, "timeout", task.timeout) {
        timeout = seconds
    } else if bad_seconds {
        tool_result(out, bad_seconds, true)
        return
    }
    run_program(out, task.name, ⟨folder: config.folder, timeout: timeout⟩, program, command)
}

//- Changing the tasks

// buckram.json as it is (an object), or an empty one if there's none.
read_config_file :: (-> value: Json) [bad_config: string] {
    value = Json.object(⟨⟩)
    if contents := read_file(join_path(config.folder, CONFIG_FILE)) is {
        case absent:
        case os_error:
            fail: bad_config = "«CONFIG_FILE» can't be read («os_error»)"
    } else {
        if parsed := parse_json(contents) {
            if parsed is object { value = parsed } else { fail: bad_config = "«CONFIG_FILE» isn't a JSON object, so it isn't changed" }
        } else if bad_json {
            fail: bad_config = "«CONFIG_FILE» isn't JSON (at byte «bad_json.at»: «bad_json.why»), so it isn't changed: fix it with edit"
        }
    }
}

// The object with its member of that name set to value (the first of the
// name replaced, or it added at the end); or, with no value, taken out.
with_member :: (object: Json_Object, name: string, value: Json, remove: bool -> Json_Object) {
    *names: [..] string
    *values: [..] Json
    *done := false
    for n, i: object.names {
        if n == name and !done {
            done = true
            if remove then continue
            names.add(n)
            values.add(value)
            continue
        }
        names.add(n)
        values.add(object.values[i])
    }
    if !done and !remove {
        names.add(name)
        values.add(value)
    }
    return ⟨names, values⟩
}

// Writes buckram.json, laid out to read.
write_config_file :: (value: Json) [bad_config: string] {
    *out: [..] u8
    write_json(out, value, 2)
    out.add("\n")
    if write_file(join_path(config.folder, CONFIG_FILE), string'out) {
    } else if absent {
        fail: bad_config = "«CONFIG_FILE» can't be written: the project's folder isn't there"
    } else if os_error {
        fail: bad_config = "«CONFIG_FILE» can't be written («os_error»)"
    }
}

// An object's members, or none for anything else.
as_object :: (value: Json -> Json_Object) {
    if value is object { return object }
    return ⟨⟩
}

// A task's name: letters, digits and _, as a tool's name is best.
good_name :: (name: string -> bool) {
    if name.count == 0 or name.count > 48 then return false
    for c: name {
        if !((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_") then return false
    }
    return true
}

add_task_tool :: (out: *[..] u8, arguments: Json) {
    name := text_member(arguments, "name")
    if !good_name(name) {
        tool_result(out, "a task's name is letters, digits and _ (up to 48), as a tool's is: not '«name»'", true)
        return
    }
    if is_own_tool(name) {
        tool_result(out, "'«name»' is one of buckram's own tools, so a task can't have that name", true)
        return
    }
    run := texts_member(arguments, "run")
    if run.count == 0 {
        tool_result(out, "add_task needs run: the program and its arguments, as a list of strings, the program first", true)
        return
    }
    *takes := text_member(arguments, "arguments")
    if takes == "" then takes = "none"
    if takes != "none" and takes != "list" {
        tool_result(out, #"a task's arguments is "none" or "list", not "«takes»""#, true)
        return
    }
    // The task, as buckram.json holds one.
    *names: [..] string
    *values: [..] Json
    description := text_member(arguments, "description")
    if description != "" {
        names.add("description")
        values.add(Json.text(description))
    }
    *pieces: [..] Json
    for piece: run { pieces.add(Json.text(piece)) }
    names.add("run")
    values.add(Json.list(pieces))
    if takes == "list" {
        names.add("arguments")
        values.add(Json.text("list"))
    }
    if t := member(arguments, "timeout") is not absent {
        if t is number {
            names.add("timeout")
            values.add(t)
        }
    }
    task := Json.object(⟨names, values⟩)
    *replaced := false
    for existing: config.tasks { if existing.name == name then replaced = true }
    if file := read_config_file() {
        *tasks := Json_Object⟨⟩
        if listed := member(file, "tasks") is not absent { tasks = as_object(listed) }
        updated := Json.object(with_member(as_object(file), "tasks", Json.object(with_member(tasks, name, task, false)), false))
        if write_config_file(updated) is bad_config {
            tool_result(out, bad_config, true)
            return
        }
    } else if bad_config {
        tool_result(out, bad_config, true)
        return
    }
    *how := "added"
    if replaced then how = "replaced"
    tool_result(out, "the task '«name»' is «how» in «CONFIG_FILE». It's a tool of its own once the client lists buckram's tools again (buckram has told it they've changed); until then, task with name '«name»' runs it.", false)
}

remove_task_tool :: (out: *[..] u8, arguments: Json) {
    name := text_member(arguments, "name")
    *found := false
    for existing: config.tasks { if existing.name == name then found = true }
    if !found {
        tool_result(out, "there's no task '«name»' in «CONFIG_FILE» (its tasks: «task_names()»)", true)
        return
    }
    if file := read_config_file() {
        *tasks := Json_Object⟨⟩
        if listed := member(file, "tasks") is not absent { tasks = as_object(listed) }
        updated := Json.object(with_member(as_object(file), "tasks", Json.object(with_member(tasks, name, ⟨⟩, true)), false))
        if write_config_file(updated) is bad_config {
            tool_result(out, bad_config, true)
            return
        }
    } else if bad_config {
        tool_result(out, bad_config, true)
        return
    }
    tool_result(out, "the task '«name»' is taken out of «CONFIG_FILE»", false)
}

run_tool :: (out: *[..] u8, arguments: Json) {
    program := text_member(arguments, "program")
    if program == "" {
        tool_result(out, "run needs a program", true)
        return
    }
    if is_git(program) {
        tool_result(out, "git goes through the git tool: it takes any of git's commands as operation (with arguments, message and folder), and saves the working tree first when one could lose work", true)
        return
    }
    *folder := text_member(arguments, "folder")
    if folder == "" { folder = config.folder } else { folder = in_project(folder) }
    *timeout := DEFAULT_TIMEOUT
    if seconds := seconds_member(arguments, "timeout", DEFAULT_TIMEOUT) {
        timeout = seconds
    } else if bad_seconds {
        tool_result(out, bad_seconds, true)
        return
    }
    run_program(out, "run", ⟨folder: folder, input: text_member(arguments, "input"), timeout: timeout⟩, program, texts_member(arguments, "arguments"))
}

// Is the program git (git, git.exe, or a path to one)?
is_git :: (program: string -> bool) {
    name := to_lower(file_name(program))
    return name == "git" or name == "git.exe"
}

git_tool :: (out: *[..] u8, arguments: Json) {
    *operation := text_member(arguments, "operation")
    if operation == "" then operation = text_member(arguments, "command")     // (its name before 741)
    if operation == "" {
        tool_result(out, "git needs an operation: status, diff, log, show, add, commit, or any other of git's commands", true)
        return
    }
    *folder := text_member(arguments, "folder")
    if folder == "" { folder = config.folder } else { folder = in_project(folder) }
    extra := texts_member(arguments, "arguments")
    // One that makes a loss permanent is run only when asked to be.
    loss := permanent_loss(operation, extra)
    if loss.count > 0 and !bool_member(arguments, "permanent") {
        tool_result(out, "git «operation» «join(extra, " ")» «loss»: that can't be undone, so it's run only with \"permanent\": true", true)
        return
    }
    // One that can lose uncommitted work: the working tree is saved first.
    *saved := ""
    if !only_looks(operation, extra) {
        if commit := save_working_tree(folder, operation) {
            saved = commit
        } else if failed {
            tool_result(out, "the working tree couldn't be saved first, so git «operation» wasn't run: «failed»", true)
            return
        }
    }
    *line: [..] string
    line.add("-c")
    line.add("core.quotepath=false")
    line.add(operation)
    *input := ""
    if operation == "commit" {
        message := text_member(arguments, "message")
        if message == "" {
            tool_result(out, "a commit needs its message, as message", true)
            return
        }
        line.add("-F")
        line.add("-")
        input = message
    }
    for piece: extra { line.add(piece) }
    *note := ""
    if saved.count > 0 {
        note = "(the working tree was saved first, untracked files too, as commit «saved[:12]»: git restore --source=«saved[:12]» -- <path> brings a file back)\n"
    }
    run_program(out, "git", ⟨folder: folder, input: input, timeout: DEFAULT_TIMEOUT⟩, "git", line, note)
}

// Does a git command only look, or only add to what's kept?
only_looks :: (operation: string, extra: [] string -> bool) {
    if operation == "stash" then return extra.count > 0 and (extra[0] == "list" or extra[0] == "show")
    if operation == "worktree" then return extra.count > 0 and extra[0] == "list"
    if operation == "reflog" then return extra.count == 0 or extra[0] == "show" or extra[0] == "exists" or starts_with(extra[0], "-")
    for name: split(LOOKING, " ") { if name == operation then return true }
    return false
}

// What a git command does that can't be undone, or nothing: dropping the
// reflog (how lost commits are found again), pruning what's unreachable
// at once, or overwriting history on a remote.
permanent_loss :: (operation: string, extra: [] string -> string) {
    if operation == "reflog" and extra.count > 0 and (extra[0] == "expire" or extra[0] == "delete") then return "drops reflog entries, how lost commits are found again"
    if operation == "prune" then return "deletes what no ref or reflog reaches"
    if operation == "gc" {
        for piece: extra {
            if starts_with(piece, "--prune") and piece != "--prune=never" then return "deletes what no ref or reflog reaches"
        }
    }
    if operation == "push" {
        for piece: extra {
            if piece == "-f" or starts_with(piece, "--force") or piece == "--mirror" or piece == "--delete" or piece == "-d" or starts_with(piece, "+") or starts_with(piece, ":") {
                return "overwrites or deletes history on the remote"
            }
        }
    }
    return ""
}

// Saves the working tree as it is (what's changed, and untracked files the
// .gitignore doesn't leave out) as a commit, refs/buckram/saved/<when>,
// without touching it or the index: through a copy of the index. Gives the
// commit, or "" when there's nothing uncommitted to save.
save_working_tree :: (folder: string, operation: string -> commit: string) [failed: string] {
    commit = ""
    status := git_output(folder, "status", "--porcelain", "--untracked-files=all")
    if status.failed then fail: failed = status.text
    if trim(status.text).count == 0 then return
    index := git_path(folder, "index")
    if index.failed then fail: failed = index.text
    copy := git_path(folder, "buckram-saved-index")
    if copy.failed then fail: failed = copy.text
    if file_exists(index.text) {
        if copy_file(index.text, copy.text) is absent or os_error then fail: failed = "the index can't be copied to «copy.text»"
    }
    if set_environment("GIT_INDEX_FILE", copy.text) is os_error then fail: failed = "GIT_INDEX_FILE can't be set"
    added := git_output(folder, "add", "-A")
    tree := git_output(folder, "write-tree")
    // (back to the real index, for the command itself)
    if set_environment("GIT_INDEX_FILE", index.text) is os_error then fail: failed = "GIT_INDEX_FILE can't be set back"
    if delete_file(copy.text) is absent or os_error { }
    if added.failed then fail: failed = added.text
    if tree.failed then fail: failed = tree.text
    *made: Git_Output = ⟨⟩
    message := "buckram: the working tree before git «operation»"
    head := git_output(folder, "rev-parse", "--verify", "--quiet", "HEAD")
    if head.failed or trim(head.text).count == 0 {
        made = git_output(folder, "-c", "user.name=buckram", "-c", "user.email=buckram@localhost", "commit-tree", trim(tree.text), "-m", message)
    } else {
        made = git_output(folder, "-c", "user.name=buckram", "-c", "user.email=buckram@localhost", "commit-tree", trim(tree.text), "-p", trim(head.text), "-m", message)
    }
    if made.failed then fail: failed = made.text
    commit = trim(made.text)
    t := to_calendar(current_time_consensus(), .LOCAL)
    when := "«t.year»«t.month_starting_at_0 + 1, ⟨width: 2, pad: "0"⟩»«t.day_of_month_starting_at_0 + 1, ⟨width: 2, pad: "0"⟩»-«t.hour, ⟨width: 2, pad: "0"⟩»«t.minute, ⟨width: 2, pad: "0"⟩»«t.second, ⟨width: 2, pad: "0"⟩»-«t.millisecond, ⟨width: 3, pad: "0"⟩»"
    kept := git_output(folder, "update-ref", "refs/buckram/saved/«when»", commit)
    if kept.failed then fail: failed = kept.text
}

// What a git command printed, and whether it failed (its text then saying
// why).
Git_Output :: struct {
    text: string
    failed: bool
}

git_output :: (folder: string, .. arguments: string -> result: Git_Output) {
    result = ⟨⟩
    if code, output, errors, timed_out := run_with(⟨folder: folder, timeout: 120⟩, "git", arguments..) {
        result.text = output
        if code != 0 or timed_out then result = ⟨"git «join(arguments, " ")»: «trim(errors)»", true⟩
    } else if absent or os_error {
        result = ⟨"git can't be run", true⟩
    }
}

// A path in the repository's git folder (its index, say), whole.
git_path :: (folder: string, name: string -> result: Git_Output) {
    result = git_output(folder, "rev-parse", "--git-path", name)
    if result.failed then return
    path := trim(result.text)
    if path.count >= 2 and path[1] == ":" { result.text = path } else { result.text = join_path(folder, path) }
}

// A path the agent gives: the project's, unless it's whole already.
in_project :: (path: string -> string) {
    if path.count >= 2 and path[1] == ":" then return path
    if starts_with(path, "/") or starts_with(path, "\\") then return path
    return join_path(config.folder, path)
}

Edit :: struct {
    file: string
    old: string
    new: string
    count: i64
}

Changed :: struct {
    path: string
    text: string
    made: bool              // a new file
}

edit_tool :: (out: *[..] u8, arguments: Json) {
    *edits: [..] Edit
    if given := member(arguments, "edits") is not absent {
        if given is list {
            for item: list {
                *e := Edit⟨text_member(item, "file"), text_member(item, "old"), text_member(item, "new"), 1⟩
                if c := member(item, "count") is not absent {
                    if c is number { if n := to_i64(number) is not invalid or too_big { e.count = n } }
                }
                edits.add(e)
            }
        }
    }
    if edits.count == 0 {
        tool_result(out, "edit needs edits: a list of {file, old, new}", true)
        return
    }
    // Each file's text, with the edits made in turn; nothing written until
    // all are found.
    *files: [..] Changed
    for e, k: edits {
        path := in_project(e.file)
        *at := -1
        for f, i: files { if f.path == path then at = i }
        if at < 0 {
            if text := read_file(path) {
                files.add(⟨path, text, false⟩)
            } else if absent {
                if e.old != "" {
                    tool_result(out, "edit «k + 1»: there's no file «e.file» (nothing was written)", true)
                    return
                }
                files.add(⟨path, "", true⟩)
            } else if os_error {
                tool_result(out, "edit «k + 1»: «e.file» can't be read: «os_error» (nothing was written)", true)
                return
            }
            at = files.count - 1
        }
        *f := ^files[at]
        if e.old == "" {
            if !f.made or f.text != "" {
                tool_result(out, "edit «k + 1»: an empty old text makes a new file, but «e.file» exists (nothing was written)", true)
                return
            }
            f.text = e.new
            continue
        }
        found := count_of(f.text, e.old)
        if found != e.count {
            tool_result(out, "edit «k + 1»: its old text is in «e.file» «found» time«plural(found)», not «e.count» (nothing was written)", true)
            return
        }
        f.text = replace(f.text, e.old, e.new)
    }
    for f: files {
        if write_file(f.path, f.text) {
        } else if absent {
            tool_result(out, "«f.path» can't be written (its folder isn't there): the files before it in the list were", true)
            return
        } else if os_error {
            tool_result(out, "«f.path» can't be written («os_error»): the files before it in the list were", true)
            return
        }
    }
    tool_result(out, "«edits.count» edit«plural(edits.count)» made, in «files.count» file«plural(files.count)»", false)
}

// Runs it, and gives back what happened as the tool's result (after the
// note, if there is one).
run_program :: (out: *[..] u8, tool_name: string, options: Run_Options, program: string, arguments: [] string, note: string = "") {
    if code, output, errors, timed_out := run_with(options, program, arguments..) {
        *text: [..] u8
        append(text, note)
        if timed_out { append(text, "timed out after «seconds_text(options.timeout)» seconds, so it was ended, with what it started\n") }
        else { append(text, "exit code «code»\n") }
        append(text, output)
        if errors.count > 0 {
            if output.count > 0 and !ends_with(output, "\n") then append(text, "\n")
            append(text, "--- errors ---\n", errors)
        }
        tool_result(out, limited(tool_name, string'text), timed_out or code != 0)
    } else if absent {
        tool_result(out, "there's no program '«program»' (a path, or a name on the PATH)", true)
    } else if os_error {
        tool_result(out, "'«program»' couldn't be run: «os_error»", true)
    }
}

// The text, cut in the middle past output_limit bytes (at a character's
// start), the whole of it kept in the output folder.
limited :: (tool_name: string, text: string -> string) {
    if text.count <= config.output_limit then return text
    folder := join_path(config.folder, config.output_folder)
    if !folder_exists(folder) { if create_folder(folder) is os_error { } }
    path := join_path(folder, "«tool_name».txt")
    *kept := "(it couldn't be kept)"
    if write_file(path, text) is not absent or os_error then kept = "all of it is in «path»"
    half := config.output_limit / 2
    *head := half
    while head > 0 and (text[head] & 0xC0) == 0x80 { head -= 1 }
    *tail := text.count - half
    while tail < text.count and (text[tail] & 0xC0) == 0x80 { tail += 1 }
    return "«text[:head]»\n... «tail - head» bytes left out here; «kept» ...\n«text[tail:]»"
}

// "s" after a count other than 1.
plural :: (n: i64 -> string) {
    if n == 1 then return ""
    return "s"
}

tool_result :: (out: *[..] u8, text: string, is_error: bool) {
    append(out, #"{"content":[{"type":"text","text":"#)
    write_json_text(out, text)
    append(out, #"}],"isError":«is_error»}"#)
}
