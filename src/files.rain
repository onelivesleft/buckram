// buckram's file and process tools: the jobs that, without a shell, took a
// program written, built and run for each (the 'rain compiler's question
// 693). A path is the project's, unless it's whole.
//
//   files      list a folder (sizes and dates; all of it beneath with all),
//              copy or move a file or folder (a file there in use moved
//              aside first), delete files and folders (clearing read-only
//              first)
//   processes  list the running processes (named like name), or end them
//              by name or ID: never buckram, or what started it

#import String
#import File
#import Json
#import System

files_tool :: (out: *String.Builder, arguments: Json.Json_Value) {
    operation := text_member(arguments, "operation")
    if operation == "list" { list_files(out, arguments); return }
    if operation == "copy" { copy_or_move(out, arguments, false); return }
    if operation == "move" { copy_or_move(out, arguments, true); return }
    if operation == "delete" { delete_paths(out, arguments); return }
    tool_result(out, "files does list, copy, move or delete (as operation), not '«operation»'", true)
}

// A member that's true, or false.
bool_member :: (value: Json.Json_Value, name: string -> bool) {
    if found := Json.member(value, name) {
        if found is boolean then return boolean
        return false
    }
    else if absent {
        return false
    }
}

//- list

list_files :: (out: *String.Builder, arguments: Json.Json_Value) {
    `scratch {
        *given := text_member(arguments, "path")
        if given == "" then given = "."
        folder := in_project(given)
        everything := bool_member(arguments, "all")
        if entries := entries_of(folder, everything) is {
            case absent:
                tool_result(out, "there's no folder «given»", true)
            case os_error:
                tool_result(out, "«given» can't be listed («os_error»)", true)
        }
        else {
            *text: String.Builder
            *files := 0
            *folders := 0
            *bytes: u64 = 0
            for entry: entries {
                // Its path in the folder listed.
                *place := entry.name
                if everything and entry.path.count > folder.count then place = String.trim_start_any(entry.path[folder.count:], "/\\")
                if entry.is_folder {
                    text.add("-\t«entry.modified»\t«place»/\n")
                    folders += 1
                }
                else {
                    text.add("«entry.size»\t«entry.modified»\t«place»\n")
                    files += 1
                    bytes += entry.size
                }
            }
            text.add("«files» file«plural(files)» («bytes» bytes), «folders» folder«plural(folders)», in «given»")
            tool_result(out, limited("files", text.build_and_reset()), false)
        }
    }
}

// A folder's entries, or with everything all beneath it.
entries_of :: (folder: string, everything: bool -> entries: [] File.Entry) [absent, os_error: File.System_Error] {
    entries = ⟨⟩
    if everything {
        if found := File.all_files(folder) { entries = found } else if absent { fail: absent } else if os_error { fail: os_error = os_error }
    }
    else {
        if found := File.files_in(folder) { entries = found } else if absent { fail: absent } else if os_error { fail: os_error = os_error }
    }
}

//- copy and move

copy_or_move :: (out: *String.Builder, arguments: Json.Json_Value, moving: bool) {
    `scratch {
        *verb := "copy"
        if moving then verb = "move"
        from_given := text_member(arguments, "from")
        to_given := text_member(arguments, "to")
        if from_given == "" or to_given == "" {
            tool_result(out, "«verb» needs from and to: the path there now, and where it goes", true)
            return
        }
        from := in_project(from_given)
        to := in_project(to_given)
        if !File.file_exists(from) and !File.folder_exists(from) {
            tool_result(out, "there's nothing at «from_given» to «verb»", true)
            return
        }
        if moving {
            why := kept_whole(from)
            if why != "" {
                tool_result(out, "«from_given» «why»: left where it is", true)
                return
            }
        }
        make_folder_for(to)
        if moving {
            if aside := move_over(from, to) is {
                case absent:
                    tool_result(out, "there's nothing at «from_given» to move", true)
                case os_error:
                    tool_result(out, "«from_given» can't be moved to «to_given» («os_error»)", true)
            }
            else {
                tool_result(out, "moved «from_given» to «to_given»«set_aside_note(aside)»", false)
            }
            return
        }
        if File.folder_exists(from) {
            if count, in_use := copy_folder(from, to) {
                *note := ""
                if in_use > 0 then note = " («in_use» there in use, so moved into old_exes beside them first, where they run on)"
                tool_result(out, "copied «from_given» to «to_given»: «count» file«plural(count)»«note»", false)
            }
            else if os_error {
                tool_result(out, "«from_given» can't all be copied to «to_given» («os_error»): what was copied before stays", true)
            }
            return
        }
        if aside := copy_over(from, to) is {
            case absent:
                tool_result(out, "there's nothing at «from_given» to copy", true)
            case os_error:
                tool_result(out, "«from_given» can't be copied to «to_given» («os_error»)", true)
        }
        else {
            tool_result(out, "copied «from_given» to «to_given»«set_aside_note(aside)»", false)
        }
    }
}

// What a result adds when the file there was moved aside.
set_aside_note :: (aside: string -> string) #pure {
    return if aside == "" then "" else " (what was there was in use, so it was moved to «aside» first, where it runs on)"
}

//- a file in use
//
// A file in use (a running program) can't be replaced, but it can be
// renamed, on Windows as on Linux: so a copy or a move onto one that fails
// moves it into old_exes beside it, where it runs on, and tries again; if
// that fails too, it's put back. Those in old_exes no longer in use are
// cleared out as another goes there.

// The file copied to to: where what was there went ("" if it stayed).
copy_over :: (from: string, to: string -> aside: string) [absent, os_error: File.System_Error] {
    aside = ""
    clear_read_only(to)
    if File.copy_file(from, to) is {
        case absent: fail: absent
        case os_error:
            aside = set_aside(to)
            if aside == "" { fail: os_error = os_error }
    }
    else {
        return
    }
    if File.copy_file(from, to) is {
        case absent:
            put_back(aside, to)
            fail: absent
        case os_error:
            put_back(aside, to)
            fail: os_error = os_error
    }
}

// The file or folder moved to to: the same.
move_over :: (from: string, to: string -> aside: string) [absent, os_error: File.System_Error] {
    aside = ""
    if File.rename_file(from, to) is {
        case absent: fail: absent
        case os_error:
            aside = set_aside(to)
            if aside == "" { fail: os_error = os_error }
    }
    else {
        return
    }
    if File.rename_file(from, to) is {
        case absent:
            put_back(aside, to)
            fail: absent
        case os_error:
            put_back(aside, to)
            fail: os_error = os_error
    }
}

// A file moved into old_exes beside it (hud.exe to old_exes/hud_1.exe), once
// those there no longer in use are cleared out: where it went, or "" if it
// isn't a file or couldn't be moved.
set_aside :: (path: string -> aside: string) {
    aside = ""
    if !File.file_exists(path) then return
    *moved_to := ""
    `scratch {
        old := File.join_path(File.folder_of(path), "old_exes")
        if File.create_folder(old) is os_error then return
        // Those no longer in use go (one still in use can't be deleted).
        if entries := File.files_in(old) is not absent or os_error {
            for entry: entries {
                if entry.is_folder then continue
                if File.delete_file(entry.path) is absent or os_error { }
            }
        }
        name := File.file_name(path)
        *n := 1
        while File.file_exists(File.join_path(old, aside_name(name, n))) { n += 1 }
        place := File.join_path(old, aside_name(name, n))
        if File.rename_file(path, place) is absent or os_error then return
        moved_to = place
    }
    aside = String.copy(moved_to)
}

// The name one moved aside gets: hud_2.exe, or buckram_2.
aside_name :: (name: string, n: i64 -> string) {
    return if File.extension(name) == "" then "«name»_«n»" else "«File.without_extension(name)»_«n».«File.extension(name)»"
}

// A file moved aside put back where it was, when what was to replace it
// couldn't.
put_back :: (aside: string, path: string) {
    if File.rename_file(aside, path) is absent or os_error { }
}

// The folders on the way to a path, made if they aren't there.
make_folder_for :: (path: string) {
    folder := File.folder_of(path)
    if folder != "" and !File.folder_exists(folder) {
        if File.create_folder(folder) is os_error { }
    }
}

// A folder and all beneath it, copied (replacing files of the same name):
// how many files, and how many of those there were in use, so moved aside.
copy_folder :: (from: string, to: string -> count: i64, in_use: i64) [os_error: File.System_Error] {
    `scratch {
        count = 0
        in_use = 0
        if File.create_folder(to) is os_error { fail: os_error = os_error }
        if entries := File.all_files(from) {
            for entry: entries {
                target := File.join_path(to, String.trim_start_any(entry.path[from.count:], "/\\"))
                if entry.is_folder {
                    if File.create_folder(target) is os_error { fail: os_error = os_error }
                }
                else {
                    if aside := copy_over(entry.path, target) {
                        count += 1
                        if aside != "" then in_use += 1
                    }
                    else if absent { } else if os_error { fail: os_error = os_error }
                }
            }
        }
        else if absent {
        }
        else if os_error {
            fail: os_error = os_error
        }
    }
}

// A read-only file made writable (as Perforce leaves files), so it can be
// replaced or deleted.
clear_read_only :: (path: string) {
    if File.make_writable(path) is absent or os_error { }
}

//- delete

delete_paths :: (out: *String.Builder, arguments: Json.Json_Value) {
    `scratch {
        paths := texts_member(arguments, "paths")
        if paths.count == 0 {
            tool_result(out, "delete needs paths: a list of the files and folders to delete", true)
            return
        }
        *text: String.Builder
        *failed := false
        for given: paths {
            path := in_project(given)
            why := kept_whole(path)
            if why != "" {
                text.add("«given» «why»: left alone\n")
                failed = true
                continue
            }
            if File.folder_exists(path) {
                if count := delete_everything(path) {
                    text.add("deleted «given»/ («count» file«plural(count)»)\n")
                }
                else if os_error {
                    text.add("«given»/ can't all be deleted («os_error»)\n")
                    failed = true
                }
                continue
            }
            clear_read_only(path)
            if File.delete_file(path) is {
                case absent:
                    text.add("«given» wasn't there\n")
                case os_error:
                    text.add("«given» can't be deleted («os_error»)\n")
                    failed = true
            }
            else {
                text.add("deleted «given»\n")
            }
        }
        tool_result(out, text.build_and_reset(), failed)
    }
}

// Why a path mustn't be deleted or moved away (it's the project's folder,
// holds it, or is a drive or /), or "". By full paths, so ".", ".." and
// the way it's written don't matter.
kept_whole :: (path: string -> string) {
    whole := `scratch comparable_path(path)
    project := `scratch comparable_path(config.folder)
    if whole.count == 0 then return "is /"
    if whole.count <= 2 then return "is a drive"
    if whole == project then return "is the project's folder"
    if String.starts_with(project, "«whole»/") then return "holds the project's folder"
    return ""
}

// A path made whole, with /, and no / at its end; on Windows, whose paths
// are the same in any case, in lower case.
comparable_path :: (path: string -> string) {
    *whole := path
    `scratch { if full := File.full_path(path) { whole = full } else if os_error { } }
    #if #program.os == .WINDOWS {
        return String.to_lower(String.trim_end_any(`scratch String.replace(whole, "\\", "/"), "/"))
    }
    #else {
        return String.copy(String.trim_end_any(whole, "/"))
    }
}

// A folder and everything in it, its read-only files included: how many
// files.
delete_everything :: (folder: string -> count: i64) [os_error: File.System_Error] {
    `scratch {
        count = 0
        if entries := File.all_files(folder) {
            for entry: entries {
                if entry.is_folder then continue
                clear_read_only(entry.path)
                count += 1
            }
        }
        else if absent {
        }
        else if os_error {
            fail: os_error = os_error
        }
        if File.delete_folder(folder, true) is {
            case absent: _
            case os_error:
                fail: os_error = os_error
        }
    }
}

//- processes

processes_tool :: (out: *String.Builder, arguments: Json.Json_Value) {
    `scratch {
        operation := text_member(arguments, "operation")
        if operation != "list" and operation != "end" {
            tool_result(out, "processes does list or end (as operation), not '«operation»'", true)
            return
        }
        *running: [] System.Process
        if found := System.processes() {
            running = found
        }
        else if os_error {
            tool_result(out, "the processes can't be listed («os_error»)", true)
            return
        }
        name := text_member(arguments, "name")
        if operation == "list" {
            *text: String.Builder
            *shown := 0
            for p: running {
                if !named_like(p.name, name) then continue
                text.add("«p.id»\t«p.parent_id»\t«p.name»\n")
                shown += 1
            }
            *which := ""
            if name != "" then which = " named like «name»"
            text.add("«shown» process«plural_es(shown)»«which» (id, parent, program)")
            tool_result(out, limited("processes", text.build_and_reset()), false)
            return
        }
        *ids: [..] i64
        if given := Json.member(arguments, "ids") is not absent {
            if given is list {
                for item: list {
                    if item is number {
                        if n := String.to_i64(number) { ids.add(n) } else if invalid or too_big { }
                    }
                }
            }
        }
        if name == "" and ids.count == 0 {
            tool_result(out, "end needs a name (its program's, such as «EXAMPLE_PROGRAM») or ids", true)
            return
        }
        // buckram, and every process above it (the stub, the agent's client):
        // ending one would end the session asking.
        *kept: [..] u32
        *at := System.process_id()
        *depth := 0
        while at != 0 and depth < 32 {
            kept.add(at)
            *parent: u32 = 0
            for p: running { if p.id == at then parent = p.parent_id }
            at = parent
            depth += 1
        }
        *text: String.Builder
        *ended := 0
        *failed := false
        for p: running {
            id := i64'(p.id)
            *picked := name != "" and p.name.equals(name, .IGNORING_CASE)
            for wanted: ids { if wanted == id then picked = true }
            if !picked then continue
            *runs_buckram := false
            for k: kept { if k == p.id then runs_buckram = true }
            if runs_buckram {
                text.add("«p.name» («p.id») is buckram, or runs it: left running\n")
                continue
            }
            if System.end_process(p.id) is {
                case absent:
                    text.add("«p.name» («p.id») had ended already\n")
                case os_error:
                    text.add("«p.name» («p.id») can't be ended («os_error»)\n")
                    failed = true
            }
            else {
                text.add("ended «p.name» («p.id»)\n")
                ended += 1
            }
        }
        if ended == 0 and !failed then text.add("no process ended: none is named «name», or has those ids\n")
        tool_result(out, text.build_and_reset(), failed)
    }
}

// A program's name, for examples.
#if #program.os == .WINDOWS {
    EXAMPLE_PROGRAM :: "rain.exe"
}
#else {
    EXAMPLE_PROGRAM :: "rain"
}

// Does the program's name contain the name given (any case)? Any does, for
// none.
named_like :: (exe_name: string, name: string -> bool) {
    if name == "" then return true
    if _ := String.first_index(exe_name, name, 0, .IGNORING_CASE) is not absent then return true
    return false
}

// "es" after a count other than 1.
plural_es :: (n: i64 -> string) {
    return if n == 1 then "" else "es"
}
