// buckram: an MCP server that gives an agent a project's tools, with no
// shell in between (core.rain has the tools, and says what each does).
//
// This is its stub, what the agent's harness starts and keeps running:
//
//     buckram.exe [project folder]      (the folder it's started in, if none)
//
// It answers initialize itself. For any other message it starts
// buckram_core.exe (buckram_core on Linux) beside it afresh, in the project's folder, gives it
// the message as its standard input, and passes on its answer; so a
// rebuilt core, or a changed buckram.json, is in use from the next message
// on, with nothing to restart. Nothing reaches the core on a command line.
//
// When buckram.json or the core has changed since the last message, it
// tells the client its tools have changed
// (notifications/tools/list_changed), so it lists them again; and it says
// so once a session starts, as a client may keep an old list.
//
// It writes only protocol messages to its standard output, a message a
// line; what it has to say otherwise goes to standard error.
//
// On Linux it runs from a copy of itself in this machine's own memory
// ($XDG_RUNTIME_DIR, or /tmp), deleted once it's running. bin/buckram may
// be on a shared folder (a VM's, from Windows) that serves a file by its
// path: when a build replaces it there, a stub running from it reads its
// next pages from the new file, and dies.

#import Console
#import String
#import File
#import System
#import Json
#import Time

// Its version (semantic versioning), from VERSION, which installing bumps
// (tools/install.rain): MCP's serverInfo gives it.
VERSION_FILE :: #data "../VERSION"
VERSION :: String.trim(string'VERSION_FILE[:])
PROTOCOL :: "2025-06-18"             // the MCP version given when the client asks for none
INSTRUCTIONS :: "buckram runs programs for you with their arguments as a list, so nothing is quoted, escaped or expanded on the way: a backslash, a $, a % or a quote arrives as you wrote it. Use it instead of a shell. The project's tasks (build, test and the like, from its buckram.json) are tools of their own: prefer one to run when there is one, in a worktree too (give its folder: the task's programs are then the worktree's). When you'll run a command more than once or twice and there's no task for it, add one with add_task: it's a tool of its own from your next call (task runs it by name meanwhile), and it's kept in buckram.json for whoever works here next. Use run for a one-off. Use git, not run, for any of git's commands (give a commit's message as message, as it is: it never goes on a command line): before one that can lose uncommitted work, it saves the working tree as a commit, and one that makes a loss permanent (reflog expire, gc --prune, a forced push) runs only with permanent: true, which needs the user's say-so. Every tool refuses a parameter it doesn't have, or one of the wrong type, and says what it takes. Use edit for several exact replacements that must all happen or none, across one file or many. Each tool gives the exit code, then the output and errors; a program that exits with another code than 0, or runs past its timeout, is an error result. Long output is cut in the middle, and the note where it's cut gives the file that has all of it: read that file for the rest rather than running the program again."
#if #program.os == .WINDOWS {
    CORE :: "buckram_core.exe"
}
#else {
    CORE :: "buckram_core"
    Linux :: #import OS_Linux
}

// What's watched for a change: a file's size and when it was written.
Seen :: struct {
    there: bool
    size: u64
    modified: Time.Timestamp
}

own_path: string                     // this program's
core: string                         // the core's path
config: string                       // buckram.json's
seen_core: Seen
seen_config: Seen

main :: (args: [] string) {
    // The core is beside this program (its path made whole before the
    // folder changes).
    *own := args[0]
    if whole := File.full_path(own) is not os_error { own = whole }
    *home := File.folder_of(own)
    #if #program.os == .LINUX {
        // The copy finds the core where the stub was started.
        if given := System.environment("BUCKRAM_HOME") is not absent or os_error {
            if given != "" {
                home = given
                forget_copy()
            }
            else {
                run_from_copy(args)
            }
        }
        else {
            run_from_copy(args)
        }
    }
    own_path = own
    core = File.join_path(home, CORE)
    if args.count > 1 {
        if System.set_current_folder(args[1]) {
        }
        else if absent {
            here := `scratch System.current_folder()
            log("there's no folder «args[1]», so it works in «here»")
        }
        else if os_error {
            here := `scratch System.current_folder()
            log("it can't work in «args[1]» («os_error»), so it works in «here»")
        }
    }
    config = File.join_path(System.current_folder(), "buckram.json")
    seen_core = seen(core)
    seen_config = seen(config)
    loop {
        // Each message in an arena of its own, released once it's answered.
        *message := arena()
        `message {
            if line := read_line() {
                handle(line)
            }
            else if end_of_input {
                return
            }
        }
    }
}

log :: (text: string) {
    echo(.ERROR, "buckram: «text»")
}

#if #program.os == .LINUX {
    // Copies this program into this machine's memory and runs the copy in
    // its place, with BUCKRAM_HOME saying where the core is; if any of it
    // fails, it runs on as it is.
    run_from_copy :: (args: [] string) {
        with scratch.rewind()
        `scratch {
            *original := ""
            if path := Linux.executable_path() { original = path } else if os_error { return }
            *folder := "/tmp"
            if runtime := System.environment("XDG_RUNTIME_DIR") is not absent or os_error {
                if File.folder_exists(runtime) then folder = runtime
            }
            copy := File.join_path(folder, "buckram-«Linux.current_process_id()»")
            if File.copy_file(original, copy) is absent or os_error then return
            if System.set_environment("BUCKRAM_HOME", File.folder_of(original)) is os_error then return
            if System.set_environment("BUCKRAM_COPY", copy) is os_error then return
            *arguments: [..] string
            arguments.add(copy)
            for argument: args[1:] { arguments.add(argument) }
            error := Linux.exec(copy, arguments, Linux.environment_entries())
            // (exec gives back only when it couldn't run it)
            log("it runs from its own file, as its copy couldn't be run («error»)")
            if File.delete_file(copy) is absent or os_error { }
            if System.set_environment("BUCKRAM_HOME", "") is os_error { }
            if System.set_environment("BUCKRAM_COPY", "") is os_error { }
        }
    }

    // In the copy: its file deleted (it runs on from memory), and the two
    // variables emptied, so a buckram that a tool starts makes its own.
    forget_copy :: () {
        if copy := System.environment("BUCKRAM_COPY") is not absent or os_error {
            if copy != "" {
                if File.delete_file(copy) is absent or os_error { }
            }
        }
        if System.set_environment("BUCKRAM_HOME", "") is os_error { }
        if System.set_environment("BUCKRAM_COPY", "") is os_error { }
    }
}

seen :: (path: string -> Seen) {
    if entry := File.file_info(path) {
        return ⟨true, entry.size, entry.modified⟩
    }
    else if absent or os_error {
        return ⟨⟩
    }
}

// Has the core or buckram.json changed since last asked?
changed :: (-> bool) {
    now_core := seen(core)
    now_config := seen(config)
    different := now_core != seen_core or now_config != seen_config
    seen_core = now_core
    seen_config = now_config
    return different
}

handle :: (line: string) {
    with scratch.rewind()
    `scratch {
        if String.trim(line).count == 0 then return
        *method := ""
        *id: Json.Json_Value
        *has_id := false
        *params: Json.Json_Value
        if request := Json.parse_json(line) {
            if m := Json.member(request, "method") is not absent {
                if m is text { method = text }
            }
            if given := Json.member(request, "id") is not absent {
                id = given
                has_id = true
            }
            if p := Json.member(request, "params") is not absent { params = p }
        }
        else if bad_json {
            respond_error(Json.Json_Value.none, -32700, "this isn't JSON: «bad_json.why» (at byte «bad_json.at»)")
            return
        }
        if method == "initialize" {
            initialize(id, params)
            return
        }
        if !has_id {
            // A notification: nothing to answer. Once a session has started,
            // its client is told the tools may differ from a list it kept.
            if method == "notifications/initialized" then tools_changed()
            return
        }
        // Anything else is the core's.
        if code, output, errors, timed_out := System.run_with(⟨input: line⟩, core) {
            if errors.count > 0 then write(.ERROR, errors)
            answer := String.trim(output)
            if answer.count > 0 {
                echo(answer)
            }
            else {
                respond_error(id, -32603, "buckram's core gave no answer (it exited with «code»)")
            }
        }
        else if absent {
            respond_error(id, -32603, "buckram's core isn't there: «core» (build it beside this, «File.file_name(own_path)»)")
        }
        else if os_error {
            respond_error(id, -32603, "buckram's core couldn't be started: «os_error»")
        }
        if changed() then tools_changed()
    }
}

tools_changed :: () {
    echo(#"{"jsonrpc":"2.0","method":"notifications/tools/list_changed"}"#)
}

initialize :: (id: Json.Json_Value, params: Json.Json_Value) {
    with scratch.rewind()
    `scratch {
        *version := PROTOCOL
        if given := Json.member(params, "protocolVersion") is not absent {
            if given is text { version = text }
        }
        *out: String.Builder
        out.add(#"{"jsonrpc":"2.0","id":"#)
        Json.write_json(out, id)
        out.add(#","result":{"protocolVersion":"#)
        Json.write_json_text(out, version)
        out.add(#","capabilities":{"tools":{"listChanged":true}},"serverInfo":{"name":"buckram","version":"«VERSION»"},"instructions":"#)
        Json.write_json_text(out, INSTRUCTIONS)
        out.add("}}")
        echo(out.build_and_reset())
    }
}

respond_error :: (id: Json.Json_Value, code: i64, message: string) {
    with scratch.rewind()
    `scratch {
        *out: String.Builder
        out.add(#"{"jsonrpc":"2.0","id":"#)
        Json.write_json(out, id)
        out.add(#","error":{"code":«code»,"message":"#)
        Json.write_json_text(out, message)
        out.add("}}")
        echo(out.build_and_reset())
    }
}
