// buckram: an MCP server that gives an agent a project's tools, with no
// shell in between (core.rain has the tools, and says what each does).
//
// This is its stub, what the agent's harness starts and keeps running:
//
//     buckram.exe [project folder]      (the folder it's started in, if none)
//
// It answers initialize itself. For any other message it starts
// buckram_core.exe (beside it) afresh, in the project's folder, gives it
// the message as its standard input, and passes on its answer; so a
// rebuilt core, or a changed buckram.json, is in use from the next message
// on, with nothing to restart. Nothing reaches the core on a command line.
//
// When buckram.json or the core has changed since the last message, it
// tells the client its tools have changed
// (notifications/tools/list_changed), so it lists them again; and it says
// so once a session starts, as a client may keep an old list.
//
// It writes only protocol messages to its standard output, a message a
// line; what it has to say otherwise goes to standard error.

#import "Console"
#import "String"
#import "File"
#import "System"
#import "Json"
#import "Time"

VERSION :: "0.2.0"
PROTOCOL :: "2025-06-18"             // the MCP version given when the client asks for none
INSTRUCTIONS :: "buckram runs programs with their arguments as a list, so nothing is quoted or expanded: use it instead of a shell. Its run, git and edit tools, and the project's tasks, give back the exit code, then the output, cut in the middle when it's long (the whole of it is kept in the output folder). A task found during the work can be added with add_task, and run with task until it's listed as a tool of its own."
CORE :: "buckram_core.exe"

// What's watched for a change: a file's size and when it was written.
Seen :: struct {
    there: bool
    size: u64
    modified: Apollo_Time
}

core: string                         // the core's path
config: string                       // buckram.json's
seen_core: Seen
seen_config: Seen

main :: (args: [] string) {
    // The core is beside this program (its path made whole before the
    // folder changes).
    *own := args[0]
    if whole := full_path(own) { own = whole } else if os_error { }
    core = join_path(folder_of(own), CORE)
    if args.count > 1 {
        if set_current_folder(args[1]) {
        } else if absent {
            log("there's no folder «args[1]», so it works in «current_folder()»")
        } else if os_error {
            log("it can't work in «args[1]» («os_error»), so it works in «current_folder()»")
        }
    }
    config = join_path(current_folder(), "buckram.json")
    seen_core = seen(core)
    seen_config = seen(config)
    loop {
        // Each message in an arena of its own, released once it's answered.
        *message := arena()
        `message {
            if line := read_line() {
                handle(line)
            } else if end_of_input {
                return
            }
        }
    }
}

log :: (text: string) {
    echo(.ERROR, "buckram: «text»")
}

seen :: (path: string -> Seen) {
    if entry := file_info(path) {
        return ⟨true, entry.size, entry.modified⟩
    } else if absent or os_error { }
    return ⟨⟩
}

// Has the core or buckram.json changed since last asked?
changed :: (-> bool) {
    now_core := seen(core)
    now_config := seen(config)
    different := now_core != seen_core or now_config != seen_config
    seen_core = now_core
    seen_config = now_config
    return different
}

handle :: (line: string) {
    if trim(line).count == 0 then return
    *method := ""
    *id: Json
    *has_id := false
    *params: Json
    if request := parse_json(line) {
        if m := member(request, "method") {
            if m is text { method = text }
        } else if absent { }
        if given := member(request, "id") {
            id = given
            has_id = true
        } else if absent { }
        if p := member(request, "params") { params = p } else if absent { }
    } else if bad_json {
        respond_error(Json.none, -32700, "this isn't JSON: «bad_json.why» (at byte «bad_json.at»)")
        return
    }
    if method == "initialize" {
        initialize(id, params)
        return
    }
    if !has_id {
        // A notification: nothing to answer. Once a session has started,
        // its client is told the tools may differ from a list it kept.
        if method == "notifications/initialized" then tools_changed()
        return
    }
    // Anything else is the core's.
    if code, output, errors, timed_out := run_with(⟨input: line⟩, core) {
        if errors.count > 0 then write(.ERROR, errors)
        answer := trim(output)
        if answer.count > 0 {
            echo(answer)
        } else {
            respond_error(id, -32603, "buckram's core gave no answer (it exited with «code»)")
        }
    } else if absent {
        respond_error(id, -32603, "buckram's core isn't there: «core» (build it beside buckram.exe)")
    } else if os_error {
        respond_error(id, -32603, "buckram's core couldn't be started: «os_error»")
    }
    if changed() then tools_changed()
}

tools_changed :: () {
    echo("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}")
}

initialize :: (id: Json, params: Json) {
    *version := PROTOCOL
    if given := member(params, "protocolVersion") {
        if given is text { version = text }
    } else if absent { }
    *out: [..] u8
    append(out, "{\"jsonrpc\":\"2.0\",\"id\":")
    write_json(out, id)
    append(out, ",\"result\":{\"protocolVersion\":")
    write_json_text(out, version)
    append(out, ",\"capabilities\":{\"tools\":{\"listChanged\":true}},\"serverInfo\":{\"name\":\"buckram\",\"version\":\"«VERSION»\"},\"instructions\":")
    write_json_text(out, INSTRUCTIONS)
    append(out, "}}")
    echo(string'out)
}

respond_error :: (id: Json, code: i64, message: string) {
    *out: [..] u8
    append(out, "{\"jsonrpc\":\"2.0\",\"id\":")
    write_json(out, id)
    append(out, ",\"error\":{\"code\":«code»,\"message\":")
    write_json_text(out, message)
    append(out, "}}")
    echo(string'out)
}
